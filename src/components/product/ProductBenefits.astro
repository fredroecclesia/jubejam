---
// Sisi kiri bagian "Product specifications", di bawah judulnya: keunggulan, cara membeli, dan tombol bagikan.
// Daftar keunggulan berlaku untuk seluruh toko, bukan per jam (data per jam ada di tabel spesifikasi).
import type { Product } from '../../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const fullName = `${product.brandName} ${product.model}`;

const benefits = [
  { icon: 'authentic', text: '100% Authentic' },
  { icon: 'card', text: 'Terima Cicilan 24x' },
  { icon: 'clock', text: 'Free Polish' },
  { icon: 'thumb', text: 'Customer Satisfaction Guarantee' },
  { icon: 'award', text: '1 Year Warranty' },
  { icon: 'tag', text: 'Under Market Price' },
];

// Langkah mengikuti FAQ "Bagaimana Cara Membeli Dari Jubejam".
const steps = [
  'Klik "Tanya admin via WhatsApp". Nama dan referensi jam ini sudah terisi otomatis di pesan.',
  'Kirim foto dan detail jam kepada admin WhatsApp kami, lalu tanyakan ketersediaan dan negosiasi harga.',
  'Lakukan DP atau pelunasan bersama admin, bisa saat melihat jam langsung maupun sebelumnya.',
];

const pageUrl = Astro.url.href;
const shareText = `${fullName} Ref. ${product.reference} di Jubejam`;
const share = [
  {
    key: 'facebook',
    label: 'Bagikan ke Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  },
  {
    key: 'x',
    label: 'Bagikan ke X (Twitter)',
    href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`,
  },
  {
    key: 'whatsapp',
    label: 'Bagikan lewat WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${shareText}\n${pageUrl}`)}`,
  },
];

const iconBase = 'h-9 w-9 shrink-0 text-gold';
---

<div class="mt-10 border-t border-hairline pt-8 lg:mt-8 lg:border-t-0 lg:pt-0">
  <ul class="flex flex-col gap-5">
    {
      benefits.map((item) => (
        <li class="flex items-center gap-5 text-[1rem] text-ink">
          <svg viewBox="0 0 24 24" class={iconBase} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {item.icon === 'authentic' && (
              <>
                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.77-4.78 4 4 0 0 1 0-6.75Z" />
                <path d="m9 12 2 2 4-4" />
              </>
            )}
            {item.icon === 'card' && (
              <>
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <path d="M2 10h20M6 15h3M13 15h5" />
              </>
            )}
            {item.icon === 'clock' && (
              <>
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </>
            )}
            {item.icon === 'thumb' && (
              <>
                <path d="M7 10v12" />
                <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" />
              </>
            )}
            {item.icon === 'award' && (
              <>
                <circle cx="12" cy="8" r="6" />
                <path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11" />
              </>
            )}
            {item.icon === 'tag' && (
              <>
                <path d="M12.59 2.59A2 2 0 0 0 11.17 2H4a2 2 0 0 0-2 2v7.17a2 2 0 0 0 .59 1.42l8.7 8.7a2.43 2.43 0 0 0 3.42 0l6.58-6.58a2.43 2.43 0 0 0 0-3.42z" />
                <circle cx="7.5" cy="7.5" r=".6" fill="currentColor" />
              </>
            )}
          </svg>
          {item.text}
        </li>
      ))
    }
  </ul>

  <h2 class="mt-10 font-serif text-[1.3rem] font-normal leading-tight text-ink">How to Purchase a watch?</h2>
  <ol class="mt-4 list-decimal space-y-2.5 pl-6 text-[0.95rem] leading-relaxed text-ink-dim marker:text-gold-light">
    {steps.map((step) => <li class="pl-1">{step}</li>)}
  </ol>

  <h2 class="mt-10 font-serif text-[1.3rem] font-normal leading-tight text-ink">Share this page</h2>
  <ul class="mt-4 flex gap-3">
    {
      share.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="flex h-11 w-11 items-center justify-center rounded-full border border-hairline text-ink transition-colors duration-200 hover:border-gold hover:text-gold-light"
          >
            {s.key === 'facebook' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
              </svg>
            )}
            {s.key === 'x' && (
              <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="currentColor" aria-hidden="true">
                <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93ZM17.61 20.64h2.04L6.49 3.24H4.3Z" />
              </svg>
            )}
            {s.key === 'whatsapp' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>