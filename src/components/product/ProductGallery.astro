---
// Galeri foto halaman detail.
// - Foto pertama dirender di server (cepat untuk LCP).
// - Thumbnail dan panah hanya muncul kalau jamnya punya lebih dari satu foto.
// - Klik foto utama membuka lightbox layar penuh: zoom (scroll, cubit, tombol +/-,
//   klik dua kali) dan geser (drag). Memakai <dialog> bawaan browser supaya Esc,
//   fokus keyboard, dan penutupan latar sudah ditangani. Semua vanilla JS, tanpa React.
import { productBadge, productImages, type Product } from '../../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const images = productImages(product);
const many = images.length > 1;
const badge = productBadge(product);

const arrow =
  'absolute top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-hairline bg-black/60 text-ink backdrop-blur transition-colors hover:border-gold hover:text-gold-light';
const tool =
  'pointer-events-auto flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-black/60 text-ink backdrop-blur transition-colors hover:border-gold hover:text-gold-light aria-disabled:opacity-35';
const svg = { fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' } as const;
---

<div data-gallery data-images={JSON.stringify(images)}>
  <div class="relative aspect-[3/4] overflow-hidden rounded-xl border border-hairline bg-bg-panel-2">
    <img
      data-gallery-main
      src={images[0].src}
      alt={images[0].alt}
      width="800"
      height="1066"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-contain"
    />
    <button
      type="button"
      data-gallery-zoom
      aria-label="Perbesar foto"
      class="absolute inset-0 cursor-zoom-in focus-visible:-outline-offset-4"
    ></button>

    <span class:list={['pointer-events-none absolute left-3 top-3 rounded-full px-2.5 py-1 text-[0.7rem] font-medium', badge.className]}>
      {badge.label}
    </span>
    <span class="pointer-events-none absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-ink-dim">
      <svg viewBox="0 0 24 24" class="h-[1.1rem] w-[1.1rem]" {...svg}>
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
      </svg>
    </span>

    {
      many && (
        <>
          <button type="button" data-gallery-prev aria-label="Foto sebelumnya" class={`${arrow} left-3`}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="m15 5-7 7 7 7" /></svg>
          </button>
          <button type="button" data-gallery-next aria-label="Foto berikutnya" class={`${arrow} right-3`}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="m9 5 7 7-7 7" /></svg>
          </button>
          <span data-gallery-counter aria-live="polite" class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-[0.72rem] text-ink-dim">
            1 / {images.length}
          </span>
        </>
      )
    }
  </div>

  {
    many && (
      <ul data-gallery-strip class="relative mt-2 flex gap-2 overflow-x-auto pb-1">
        {images.map((img, i) => (
          <li class="w-[22%] max-w-[112px] shrink-0">
            <button
              type="button"
              data-gallery-thumb
              data-index={i}
              aria-label={`Lihat foto ${i + 1} dari ${images.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
              class="block aspect-square w-full overflow-hidden rounded-lg border border-hairline bg-bg-panel-2 transition-colors hover:border-gold-light aria-[current=true]:border-[1.5px] aria-[current=true]:border-gold"
            >
              <img src={img.src} alt="" width="200" height="200" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </button>
          </li>
        ))}
      </ul>
    )
  }

  <dialog
    data-lightbox
    aria-label={`Foto ${product.brandName} ${product.model}`}
    class="m-0 h-full max-h-none w-full max-w-none border-0 bg-black p-0 text-ink"
  >
    <div
      data-lb-stage
      class="relative h-full w-full touch-none select-none overflow-hidden cursor-zoom-in data-[zoomed=true]:cursor-grab"
    >
      <img
        data-lb-img
        src={images[0].src}
        alt={images[0].alt}
        draggable="false"
        class="absolute inset-0 h-full w-full object-contain will-change-transform"
      />
    </div>

    <div class="pointer-events-none absolute inset-x-0 top-0 flex items-center justify-between gap-3 p-3 sm:p-5">
      <span data-lb-counter aria-live="polite" class="rounded-full bg-black/60 px-3 py-1.5 text-[0.8rem] text-ink-dim">
        {many ? `1 / ${images.length}` : ''}
      </span>
      <div class="flex gap-2">
        <button type="button" data-lb-out aria-label="Perkecil" class={tool}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="M5 12h14" /></svg>
        </button>
        <button type="button" data-lb-in aria-label="Perbesar" class={tool}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="M12 5v14M5 12h14" /></svg>
        </button>
        <button type="button" data-lb-close aria-label="Tutup" autofocus class={tool}>
          <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
    </div>

    {
      many && (
        <>
          <button type="button" data-lb-prev aria-label="Foto sebelumnya" class={`${tool} absolute left-3 top-1/2 -translate-y-1/2 sm:left-5`}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="m15 5-7 7 7 7" /></svg>
          </button>
          <button type="button" data-lb-next aria-label="Foto berikutnya" class={`${tool} absolute right-3 top-1/2 -translate-y-1/2 sm:right-5`}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" {...svg}><path d="m9 5 7 7-7 7" /></svg>
          </button>
        </>
      )
    }

    <div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center px-4">
      <p class="rounded-full bg-black/60 px-3.5 py-1.5 text-center text-[0.75rem] text-ink-dim backdrop-blur">
        Klik atau ketuk dua kali untuk zoom, geser untuk menggerakkan foto
      </p>
    </div>
  </dialog>
</div>

<script>
  type Img = { src: string; alt: string };

  const MIN = 1;
  const MAX = 4;
  const DOUBLE_TAP_SCALE = 2.5;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const images: Img[] = JSON.parse(root.dataset.images ?? '[]');
    if (images.length === 0) return;

    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const main = q<HTMLImageElement>('[data-gallery-main]')!;
    const counter = q('[data-gallery-counter]');
    const strip = q('[data-gallery-strip]');
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));

    // ---------------------------------------------------------------- galeri
    let current = 0;
    const show = (index: number) => {
      current = (index + images.length) % images.length;
      main.src = images[current].src;
      main.alt = images[current].alt;
      if (counter) counter.textContent = `${current + 1} / ${images.length}`;
      thumbs.forEach((el, i) => el.setAttribute('aria-current', String(i === current)));
      // Geser hanya barisan thumbnail (bukan halaman) supaya thumbnail aktif terlihat.
      const item = thumbs[current]?.parentElement;
      if (strip && item) {
        strip.scrollTo({ left: item.offsetLeft - (strip.clientWidth - item.offsetWidth) / 2, behavior: 'smooth' });
      }
    };

    thumbs.forEach((el, i) => el.addEventListener('click', () => show(i)));
    q('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
    q('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));

    // -------------------------------------------------------------- lightbox
    const dialog = q<HTMLDialogElement>('[data-lightbox]')!;
    const stage = q('[data-lb-stage]')!;
    const lbImg = q<HTMLImageElement>('[data-lb-img]')!;
    const lbCounter = q('[data-lb-counter]');
    const btnIn = q<HTMLButtonElement>('[data-lb-in]')!;
    const btnOut = q<HTMLButtonElement>('[data-lb-out]')!;

    let scale = 1;
    let tx = 0;
    let ty = 0;

    // Ukuran foto yang tampil (object-contain) pada skala 1, untuk membatasi geseran.
    const fit = () => {
      const sw = stage.clientWidth;
      const sh = stage.clientHeight;
      const nw = lbImg.naturalWidth || 1;
      const nh = lbImg.naturalHeight || 1;
      const r = Math.min(sw / nw, sh / nh);
      return { sw, sh, w: nw * r, h: nh * r };
    };

    const apply = (animate = false) => {
      const { sw, sh, w, h } = fit();
      const mx = Math.max(0, (w * scale - sw) / 2);
      const my = Math.max(0, (h * scale - sh) / 2);
      tx = Math.min(mx, Math.max(-mx, tx));
      ty = Math.min(my, Math.max(-my, ty));
      lbImg.style.transition = animate ? 'transform 180ms ease-out' : 'none';
      lbImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      stage.dataset.zoomed = String(scale > 1.001);
      // aria-disabled (bukan disabled) supaya fokus keyboard tidak hilang saat batas zoom tercapai.
      btnOut.setAttribute('aria-disabled', String(scale <= MIN + 0.001));
      btnIn.setAttribute('aria-disabled', String(scale >= MAX - 0.001));
    };

    // (cx, cy) = titik yang dijaga tetap diam, relatif terhadap pusat stage.
    const zoomAt = (next: number, cx: number, cy: number, animate = false) => {
      next = Math.min(MAX, Math.max(MIN, next));
      const k = next / scale;
      tx = cx - (cx - tx) * k;
      ty = cy - (cy - ty) * k;
      scale = next;
      if (scale === MIN) {
        tx = 0;
        ty = 0;
      }
      apply(animate);
    };

    const stagePoint = (p: { clientX: number; clientY: number }) => {
      const r = stage.getBoundingClientRect();
      return { x: p.clientX - r.left - r.width / 2, y: p.clientY - r.top - r.height / 2 };
    };

    const load = () => {
      lbImg.src = images[current].src;
      lbImg.alt = images[current].alt;
      if (lbCounter && images.length > 1) lbCounter.textContent = `${current + 1} / ${images.length}`;
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    };

    const go = (delta: number) => {
      show(current + delta);
      load();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === '+' || e.key === '=') zoomAt(scale * 1.5, 0, 0, true);
      else if (e.key === '-') zoomAt(scale / 1.5, 0, 0, true);
      else if (e.key === '0') zoomAt(1, 0, 0, true);
      else if (e.key === 'ArrowLeft' && images.length > 1) go(-1);
      else if (e.key === 'ArrowRight' && images.length > 1) go(1);
    };

    q('[data-gallery-zoom]')?.addEventListener('click', () => {
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      load();
      document.addEventListener('keydown', onKey);
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
    });
    q('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    btnIn.addEventListener('click', () => zoomAt(scale * 1.5, 0, 0, true));
    btnOut.addEventListener('click', () => zoomAt(scale / 1.5, 0, 0, true));
    q('[data-lb-prev]')?.addEventListener('click', () => go(-1));
    q('[data-lb-next]')?.addEventListener('click', () => go(1));
    lbImg.addEventListener('load', () => apply());
    window.addEventListener('resize', () => dialog.open && apply());

    // Scroll mouse / cubit di trackpad.
    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const p = stagePoint(e);
        zoomAt(scale * Math.exp(-e.deltaY * (e.ctrlKey ? 0.01 : 0.0015)), p.x, p.y);
      },
      { passive: false }
    );

    // Pointer events: satu jari/mouse = geser (saat sudah di-zoom), dua jari = cubit,
    // ketuk/klik dua kali = zoom cepat.
    const pts = new Map<number, { x: number; y: number }>();
    let pinch: { dist: number; scale: number } | null = null;
    let down: { x: number; y: number; t: number } | null = null;
    let lastTap = { t: 0, x: 0, y: 0 };

    stage.addEventListener('pointerdown', (e) => {
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {
        /* pointer sintetis / sudah dilepas: abaikan */
      }
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      down = pts.size === 1 ? { x: e.clientX, y: e.clientY, t: Date.now() } : null;
      if (pts.size === 2) {
        const [a, b] = [...pts.values()];
        pinch = { dist: Math.hypot(a.x - b.x, a.y - b.y) || 1, scale };
      }
    });

    stage.addEventListener('pointermove', (e) => {
      const prev = pts.get(e.pointerId);
      if (!prev) return;
      const cur = { x: e.clientX, y: e.clientY };
      pts.set(e.pointerId, cur);

      if (pts.size === 2 && pinch) {
        const [a, b] = [...pts.values()];
        const mid = stagePoint({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 });
        zoomAt((pinch.scale * Math.hypot(a.x - b.x, a.y - b.y)) / pinch.dist, mid.x, mid.y);
      } else if (pts.size === 1 && scale > MIN) {
        tx += cur.x - prev.x;
        ty += cur.y - prev.y;
        apply();
      }
    });

    const release = (e: PointerEvent) => {
      const wasSingle = pts.size === 1;
      pts.delete(e.pointerId);
      if (pts.size < 2) pinch = null;

      const isTap = e.type === 'pointerup' && wasSingle && down && Math.hypot(e.clientX - down.x, e.clientY - down.y) < 8 && Date.now() - down.t < 300;
      down = null;
      if (!isTap) return;

      const now = Date.now();
      if (now - lastTap.t < 300 && Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) < 30) {
        const p = stagePoint(e);
        zoomAt(scale > MIN ? MIN : DOUBLE_TAP_SCALE, p.x, p.y, true);
        lastTap = { t: 0, x: 0, y: 0 };
      } else {
        lastTap = { t: now, x: e.clientX, y: e.clientY };
      }
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
  });
</script>