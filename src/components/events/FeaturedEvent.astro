---
import { WHATSAPP_URL } from '../../data/faqs';

interface Props {
  src: string;
  alt: string;
  status?: string;
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  src,
  alt,
  status = 'Sedang berlangsung',
  title,
  description,
  ctaLabel = 'Tanya admin via WhatsApp',
  ctaHref = WHATSAPP_URL,
} = Astro.props;
---

<article class="overflow-hidden rounded-lg border border-hairline bg-bg-panel">
  <div class="overflow-hidden border-b border-hairline bg-bg-panel-2">
    <img
      src={src}
      alt={alt}
      width="1600"
      height="778"
      loading="eager"
      decoding="async"
      class="aspect-[1600/778] h-auto w-full object-cover"
    />
  </div>

  <div class="grid gap-6 p-6 sm:p-8 md:grid-cols-[1.4fr_1fr] md:items-center md:gap-12">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full bg-gold px-3 py-1 text-[0.74rem] font-semibold text-[#14110A]">
        <i class="block h-1.5 w-1.5 rounded-full bg-[#14110A]" aria-hidden="true"></i>
        {status}
      </span>
      <h3 class="mt-4 font-serif text-[clamp(1.4rem,2.4vw,1.9rem)] font-normal leading-tight text-ink">
        {title}
      </h3>
      <p class="mt-3 max-w-[52ch] text-[0.92rem] leading-relaxed text-ink-dim">
        {description}
      </p>
    </div>

    <div class="flex flex-col gap-3 md:items-stretch">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-gold px-6 py-[13px] text-[0.9rem] font-semibold text-[#14110A] transition-colors duration-200 hover:bg-gold-light"
      >
        {ctaLabel}
      </a>
      <a
        href="/produk"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-gold px-6 py-[13px] text-[0.9rem] font-semibold text-gold-light transition-colors duration-200 hover:bg-gold hover:text-[#14110A]"
      >
        Lihat katalog
      </a>
    </div>
  </div>
</article>
