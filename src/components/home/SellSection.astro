---
import { WHATSAPP_URL } from '../../data/faqs';

// Isi opsi mengikuti FAQ "Consignment, Tukar Tambah, Dan Penjualan".
const options = [
  {
    title: 'Penjualan',
    desc: 'Jual jam Anda langsung ke Jubejam.',
    svg: '<path d="M11 4h7a2 2 0 0 1 2 2v7l-9 9-9-9 9-9z"/><circle cx="14.5" cy="9.5" r="1.5"/>',
  },
  {
    title: 'Consignment',
    desc: 'Titipkan jam Anda untuk kami jualkan.',
    svg: '<path d="M20 11a8 8 0 0 0-14.9-4M4 13a8 8 0 0 0 14.9 4"/><path d="M5 3v4h4M19 21v-4h-4"/>',
  },
  {
    title: 'Tukar tambah',
    desc: 'Tukar jam lama dengan koleksi lain.',
    svg: '<path d="M4 8h13M17 8l-3.5-3.5M17 8l-3.5 3.5"/><path d="M20 16H7M7 16l3.5-3.5M7 16l3.5 3.5"/>',
  },
];

const trustPoints = [
  {
    title: 'Proses Aman',
    desc: 'Data & transaksi terjamin',
    svg: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  },
  {
    title: 'Penawaran Cepat',
    desc: 'Hanya dalam hitungan jam',
    svg: '<path d="M13 3L4 14h6l-1 7 9-11h-6l1-7z"/>',
  },
  {
    title: 'Tim Profesional',
    desc: 'Berpengalaman & terpercaya',
    svg: '<path d="M8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M16 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M3 20c.5-3 2.8-5 5-5s4.5 2 5 5"/><path d="M11 20c.5-3 2.8-5 5-5s4.5 2 5 5"/>',
  },
];
---
<section id="jual" aria-labelledby="sell-title" class="sell bg-black">
  <div class="sell-grid">
    <!-- KIRI (≈58,5%): foto jam + headline + CTA -->
    <div class="sell-left relative isolate flex flex-col overflow-hidden">
      <img
        src="/sell/sell-hero-2.jpg"
        alt=""
        aria-hidden="true"
        class="sell-photo absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/60 via-black/10 to-transparent"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/40 via-transparent to-black/30"></div>

      <div>
        <div class="flex items-center gap-4">
          <p class="eyebrow whitespace-nowrap">Jual atau tukar jam Anda</p>
          <span class="h-px w-20 bg-gold/60"></span>
        </div>
        <h2 id="sell-title" class="sell-title mt-5 max-w-[12ch]">
          Punya jam yang <em class="italic text-gold-light">ingin dilepas?</em>
        </h2>
        <p class="sell-lead mt-6 max-w-[44ch]">
          Selain membeli, Anda juga bisa melepas jam lewat Jubejam. Kirim detail dan foto jam Anda, admin kami akan mengirimkan penawaran lewat nomor yang Anda isi.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/sell-my-watch" class="btn btn-gold sell-btn gap-3">
            Jual jam Anda
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline sell-btn gap-3">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21c4.97 0 9-3.8 9-8.5S16.97 4 12 4s-9 3.8-9 8.5c0 1.6.47 3.1 1.29 4.38L3 21l4.4-1.24C8.63 20.55 10.26 21 12 21z"/>
              <path d="M9.2 8.8c-.3.5-.2 1.4.6 2.6.9 1.3 1.9 2.1 3 2.4.7.2 1.3-.1 1.5-.6l-1.2-.9-.6.4c-.6-.3-1.3-1-1.6-1.6l.4-.6-.9-1.2c-.4 0-.9.2-1.2.5z"/>
            </svg>
            Tanya via WhatsApp
          </a>
        </div>

        <ul class="mt-12 flex flex-wrap items-stretch gap-y-5">
          {
            trustPoints.map((t) => (
              <li class="trust-item flex items-center gap-3 pr-6 sm:pr-7 [&:not(:first-child)]:pl-6 sm:[&:not(:first-child)]:pl-7">
                <svg viewBox="0 0 24 24" class="h-7 w-7 shrink-0 text-gold-light" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.svg} />
                <div>
                  <p class="text-[0.88rem] font-medium text-ink">{t.title}</p>
                  <p class="mt-0.5 text-[0.76rem] text-ink-dim">{t.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sell-brand flex flex-wrap items-center gap-x-4 gap-y-1">
        <div class="flex items-center gap-4">
          <p class="font-sans text-[0.74rem] font-medium uppercase tracking-[0.35em] text-gold-light">Jubejam</p>
          <span class="h-px w-14 bg-gold/50"></span>
        </div>
        <p class="basis-full font-sans text-[0.68rem] uppercase tracking-[0.3em] text-ink-dim">Trusted Watch Partner</p>
      </div>
    </div>

    <!-- KANAN (≈41,5%): pilihan layanan -->
    <div class="sell-right relative flex flex-col">
      <span class="sell-divider" aria-hidden="true"></span>

      <div class="flex items-center gap-4">
        <p class="eyebrow whitespace-nowrap">Kenapa pilih Jubejam?</p>
        <span class="h-px w-20 bg-gold/60"></span>
      </div>
      <h3 class="sell-subtitle mt-5">
        Proses Mudah,<br />
        <em class="font-serif italic font-normal text-gold-light">Aman dan Terpercaya</em>
      </h3>

      <ul class="mt-10 divide-y divide-white/10 border-b border-white/10">
        {
          options.map((o) => (
            <li>
              <a href="/sell-my-watch" class="group flex items-center gap-6 py-7">
                <span class="icon-orb">
                  <svg viewBox="0 0 24 24" class="h-7 w-7 text-gold-light" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={o.svg} />
                </span>
                <div class="flex-1">
                  <h4 class="font-serif text-[1.35rem] text-ink">{o.title}</h4>
                  <p class="mt-1 max-w-[26ch] text-[0.95rem] leading-relaxed text-ink-dim">{o.desc}</p>
                </div>
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-gold-light transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Rasio kiri:kanan mengikuti desain referensi (1038 : 736 ≈ 58,5% : 41,5%).
     Ditulis lewat <style> biasa supaya tidak bergantung pada scan Tailwind. */
  .sell-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  .sell-left {
    padding: 4rem 1.25rem 2.5rem;
    min-height: 34rem;
  }
  .sell-right {
    background: #121212; /* sama dengan bg-panel (abu-abu section Video) */
    padding: 3.5rem 1.25rem 3rem;
    border-top: 1px solid rgba(201, 164, 107, 0.35);
  }
  .sell-divider {
    display: none;
  }
  .sell-photo {
    object-position: 85% 100%;
  }

  .sell-title {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    line-height: 1.08;
    color: #edeae2;
    font-size: clamp(2.5rem, 9vw, 3.5rem);
  }
  .sell-subtitle {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    line-height: 1.12;
    color: #edeae2;
    font-size: clamp(1.9rem, 6vw, 2.4rem);
  }
  .sell-lead {
    font-size: 1rem;
    line-height: 1.65;
    color: #a9aebb;
  }
  .sell-brand {
    margin-top: 3rem;
  }
  .sell-btn {
    padding: 1rem 2rem;
    font-size: 0.95rem;
  }

  .trust-item:not(:first-child) {
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }
  @media (max-width: 639px) {
    .trust-item {
      width: 100%;
      border-left: 0 !important;
      padding-left: 0 !important;
    }
  }

  /* Ikon bulat dengan glow emas halus, seperti di desain */
  .icon-orb {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(201, 164, 107, 0.28);
    background: radial-gradient(circle at 50% 35%, #2a241a 0%, #120f0a 62%, #0a0908 100%);
    box-shadow:
      0 0 0 5px rgba(201, 164, 107, 0.05),
      0 10px 26px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .group:hover .icon-orb {
    border-color: rgba(221, 187, 133, 0.6);
    box-shadow:
      0 0 0 5px rgba(201, 164, 107, 0.1),
      0 0 22px rgba(201, 164, 107, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .sell-left {
      padding: 5rem 2rem 3rem;
    }
    .sell-right {
      padding: 4rem 2rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .sell-grid {
      grid-template-columns: 1038fr 736fr; /* = 58,5% : 41,5% */
      min-height: clamp(40rem, 50vw, 62rem); /* proporsi ±2:1 seperti desain */
    }
    .sell-left {
      min-height: 0;
      justify-content: space-between;
      padding-top: clamp(4rem, 7.5vw, 8.5rem);
      padding-bottom: clamp(2.5rem, 5vw, 5.5rem);
      padding-left: clamp(3rem, 5.3vw, 7rem);
      padding-right: 2rem;
    }
    .sell-right {
      border-top: 0;
      padding-top: clamp(3rem, 5vw, 6rem);
      padding-bottom: clamp(2rem, 3.5vw, 4rem);
      padding-left: clamp(2rem, 4.3vw, 6rem);
      padding-right: clamp(2rem, 5.5vw, 8rem);
    }
    /* garis emas vertikal pemisah, mulai sedikit dari atas & memudar ke bawah */
    .sell-divider {
      display: block;
      position: absolute;
      left: 0;
      top: 5.4%;
      bottom: 0;
      width: 1px;
      background: linear-gradient(
        to bottom,
        rgba(201, 164, 107, 0.85),
        rgba(201, 164, 107, 0.55) 60%,
        rgba(201, 164, 107, 0.35)
      );
    }
    .sell-photo {
      object-position: right bottom;
    }
    .sell-title {
      font-size: clamp(3rem, 4.1vw, 4.6rem);
    }
    .sell-subtitle {
      font-size: clamp(2rem, 2.75vw, 3.1rem);
    }
    .sell-lead {
      font-size: clamp(1rem, 1.2vw, 1.3rem);
    }
    .sell-brand {
      margin-top: 2rem;
    }
  }
</style>