---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAllEventsAdmin } from '../../../data/events';

export const prerender = false;

const events = await listAllEventsAdmin();
---

<AdminLayout title="Event" active="events">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-serif text-2xl text-ink">Event</h1>
      <p class="text-sm text-ink-dim">{events.length} event total.</p>
    </div>
    <a href="/admin/events/baru" class="rounded bg-gold text-[#14110A] font-medium px-4 py-2 text-sm hover:bg-gold-light transition-colors">
      + Tambah Event
    </a>
  </div>

  {events.length === 0 ? (
    <p class="text-ink-dim border border-dashed border-hairline rounded-lg px-6 py-12 text-center">
      Belum ada event. Klik "Tambah Event" untuk mulai isi halaman Event &amp; Update.
    </p>
  ) : (
    <div class="border border-hairline rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-bg-panel-2 text-ink-dim text-left">
          <tr>
            <th class="px-4 py-3 font-normal">Foto</th>
            <th class="px-4 py-3 font-normal">Event</th>
            <th class="px-4 py-3 font-normal">Featured</th>
            <th class="px-4 py-3 font-normal"></th>
          </tr>
        </thead>
        <tbody>
          {events.map((ev) => (
            <tr class="border-t border-hairline">
              <td class="px-4 py-3">
                <img src={ev.image} alt={ev.imageAlt} class="w-16 h-10 object-cover rounded" />
              </td>
              <td class="px-4 py-3">
                <div class="text-ink">{ev.title}</div>
              </td>
              <td class="px-4 py-3">
                {ev.featured ? (
                  <span class="text-xs px-2 py-1 rounded bg-[#3a331f] text-gold-light">Featured</span>
                ) : (
                  <span class="text-ink-dim text-xs">—</span>
                )}
              </td>
              <td class="px-4 py-3 text-right space-x-3 whitespace-nowrap">
                <a href={`/admin/events/${ev.id}/edit`} class="text-gold-light hover:underline">Edit</a>
                <button
                  type="button"
                  class="text-[#F09595] hover:underline js-delete-event"
                  data-id={ev.id}
                  data-nama={ev.title}
                >
                  Hapus
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll('.js-delete-event').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const nama = btn.getAttribute('data-nama');
      if (!confirm(`Hapus event "${nama}"? Tindakan ini tidak bisa dibatalkan.`)) return;

      const res = await fetch(`/api/admin/events/${id}`, { method: 'DELETE' });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        alert(data.error ?? 'Gagal menghapus event.');
        return;
      }
      window.location.reload();
    });
  });
</script>
