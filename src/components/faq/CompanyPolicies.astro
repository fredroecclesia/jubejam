---
// Kolom kiri halaman FAQ (sesuai referensi: hanya Warranty Terms and condition).
// Terms, Privacy, dan Return Policy sudah ada di Footer, jadi tidak diulang di sini.
// href yang diawali '#' masih placeholder (halamannya belum ada).
const policies = [
  { label: 'Warranty Terms and condition', href: 'https://drive.google.com/file/d/1Y-nkxw4fm0fVKexNVwDJ1NqAYEg5qm1a/view' },
];
---

<aside class="order-last lg:order-none lg:sticky lg:top-28 lg:self-start">
  <h2 class="font-serif text-[clamp(1.6rem,2.4vw,2.1rem)] font-normal uppercase leading-tight text-ink">
    Company Policies
  </h2>
  <nav aria-label="Company policies" class="mt-6">
    <ul class="flex flex-col gap-3.5">
      {
        policies.map((p) => (
          <li>
            <a href={p.href} class="text-[0.98rem] text-ink-dim underline-offset-4 transition-colors duration-200 hover:text-ink hover:underline">
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>