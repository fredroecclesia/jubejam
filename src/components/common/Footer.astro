---
interface FooterLink {
  label: string;
  href: string;
}

const year = new Date().getFullYear();

const socials = [
  {
    name: 'Instagram',
    label: 'Instagram Jubejam (@jubejam.official)',
    href: 'https://www.instagram.com/jubejam.official/',
  },
  {
    name: 'TikTok',
    label: 'TikTok Jubejam (@jubejamindonesia)',
    href: 'https://www.tiktok.com/@jubejamindonesia',
  },
];

const storeLinks: FooterLink[] = [
  { label: 'Katalog', href: '/produk' },
  { label: 'Lokasi toko', href: '/#offline-store' },
  { label: 'Event & update', href: '/events-updates' },
  { label: 'FAQ', href: '/faqs' },
];

const legalLinks: FooterLink[] = [
  { label: 'Syarat & ketentuan', href: '/terms' },
  { label: 'Kebijakan privasi', href: '/privacy-policy' },
  { label: 'Kebijakan pengembalian', href: '/return-policy' },
];
---

<footer id="footer" class="border-t border-hairline bg-black text-ink">
  <div class="mx-auto max-w-[1180px] px-5 pb-10 pt-14 sm:px-8 sm:pt-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[0.8fr_1.2fr_1fr] md:gap-10">
      <div>
        <h2 class="eyebrow">Ikuti kami</h2>
        <ul class="mt-6 flex items-center gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/10"
                >
                  {s.name === 'Instagram' ? (
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                      <circle cx="12" cy="12" r="4.2"></circle>
                      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
                      <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Store dan layanan">
        <h2 class="eyebrow">Toko &amp; layanan</h2>
        <ul class="mt-6 flex flex-col gap-3.5">
          {
            storeLinks.map((l) => (
              <li>
                <a href={l.href} class="text-ink/80 underline-offset-4 transition-colors hover:text-gold-light">{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Privasi dan ketentuan">
        <h2 class="eyebrow">Kebijakan</h2>
        <ul class="mt-6 flex flex-col gap-3.5">
          {
            legalLinks.map((l) => (
              <li>
                <a href={l.href} class="text-ink/80 underline-offset-4 transition-colors hover:text-gold-light">{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-14 text-[0.9rem] text-ink-dim sm:mt-16">
      &copy; {year} PT Trio Tunas Jaya. All rights reserved.
    </p>
  </div>
</footer>

<!-- Tombol kembali ke atas: muncul setelah user scroll cukup jauh -->
<button
  id="backToTop"
  type="button"
  aria-label="Kembali ke atas"
  class="pointer-events-none fixed bottom-5 right-5 z-[70] flex h-12 w-12 translate-y-2 items-center justify-center rounded bg-gold text-[#14110A] opacity-0 shadow-[0_6px_20px_rgba(0,0,0,0.35)] transition-all duration-300 hover:bg-gold-light data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:bottom-8 sm:right-8"
>
  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 15l7-7 7 7"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('backToTop');

  if (btn) {
    let ticking = false;

    function update() {
      btn!.dataset.visible = String(window.scrollY > 600);
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    update();
  }
</script>