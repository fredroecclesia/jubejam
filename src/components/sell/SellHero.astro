---
// Banner judul halaman Sell My Watch: foto gelap full-bleed.
// Foto ini sudah termasuk judul "SELL MY WATCH" di dalamnya (sesuai referensi
// desain lama), jadi tidak ada <h1> yang di-overlay lagi di atasnya — hanya
// heading tersembunyi (sr-only) untuk aksesibilitas & SEO.
// PENTING: tinggi section di sini sengaja ditulis lewat <style> biasa (bukan
// class Tailwind arbitrary seperti h-[220px]) supaya tidak bergantung pada
// Tailwind JIT men-scan file ini dengan benar. Kalau setelah file ini
// diganti hero masih terpotong persis seperti sebelumnya, itu tandanya
// perubahan belum ke-deploy/ke-cache browser — bukan bug di kode ini lagi.
interface Props {
  title?: string;
}
const { title = 'Sell My Watch' } = Astro.props;
---

<section class="sell-hero">
  <img
    src="/sell/sell-hero.jpg"
    alt={title}
    width="1920"
    height="636"
    decoding="async"
    fetchpriority="high"
  />
  <h1 class="sr-only">{title}</h1>
</section>

<style>
  .sell-hero {
    position: relative;
    overflow: hidden;
    background: #000;
    height: 220px;
  }
  .sell-hero img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .sell-hero {
      height: 320px;
    }
  }
  @media (min-width: 1024px) {
    .sell-hero {
      height: 440px;
    }
  }
</style>