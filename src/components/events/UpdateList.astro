---
import EventPhoto from './EventPhoto.astro';

interface UpdateItem {
  src: string;
  alt: string;
  href: string;
}

interface Props {
  updates: UpdateItem[];
}

const { updates } = Astro.props;
---

<section id="update" class="border-t border-hairline bg-bg-panel py-12 sm:py-16">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
    <h2 class="font-serif text-[clamp(1.6rem,3vw,2.2rem)] font-normal leading-tight text-ink">Update</h2>
    <p class="mt-3 max-w-[46ch] text-[0.92rem] leading-relaxed text-ink-dim">
      Kabar koleksi, panduan memilih, dan pengetahuan seputar jam mewah.
    </p>

    <ul class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
      {
        updates.map((item) => (
          <li>
            <EventPhoto src={item.src} alt={item.alt} href={item.href} variant="update" />
          </li>
        ))
      }
    </ul>
  </div>
</section>
