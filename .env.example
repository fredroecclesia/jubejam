# Neon Postgres — buat project di https://neon.tech, salin "Connection string"
# (yang pooled/HTTP-compatible, bukan yang khusus psql).
DATABASE_URL=

# Auth admin — satu password + secret untuk menandatangani cookie sesi.
ADMIN_PASSWORD=
SESSION_SECRET=

# Neon Object Storage (buat foto produk) — Neon Console > project > branch >
# sidebar "APP BACKEND" > Credentials > Create credential (centang
# storage:read + storage:write) > Download .env. Nilainya persis dari situ,
# jangan diubah namanya (AWS_* dipakai apa adanya oleh AWS SDK).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Nama bucket yang kamu buat di tab "Storage" — WAJIB access level
# "public_read" (bukan default "private"), supaya foto bisa dibuka browser.
NEON_STORAGE_BUCKET=
