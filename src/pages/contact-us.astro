---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactMap from '../components/contact/ContactMap.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
---

<Layout
  title="Contact Us — Jubejam"
  description="Hubungi Jubejam lewat WhatsApp, email, atau formulir pesan, dan kunjungi toko offline kami di Pantai Indah Kapuk."
>
  <Header />

  <main>
    <ContactHero />

    <!--
      Peta di kiri, formulir + kontak di kanan (mengikuti referensi).
      Di layar kecil formulir tampil dulu, peta di bawahnya.
      Tata letak ditulis lewat <style> biasa supaya tidak bergantung pada scan Tailwind JIT.
    -->
    <section id="lokasi" class="contact-split">
      <div class="contact-split__map">
        <ContactMap />
      </div>
      <div class="contact-split__panel">
        <div class="contact-split__inner">
          <ContactForm />
          <ContactInfo />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-split {
    display: grid;
    grid-template-columns: 1fr;
    background: #121212;
  }
  .contact-split__map {
    order: 2;
    min-height: 340px;
  }
  .contact-split__panel {
    order: 1;
    padding: 3rem 1.25rem;
  }
  .contact-split__inner {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 640px) {
    .contact-split__panel {
      padding: 3.5rem 2rem;
    }
  }
  @media (min-width: 1024px) {
    .contact-split {
      grid-template-columns: 1fr 1fr;
    }
    .contact-split__map {
      order: 1;
    }
    .contact-split__panel {
      order: 2;
      padding: 4rem 3rem;
    }
  }
</style>
