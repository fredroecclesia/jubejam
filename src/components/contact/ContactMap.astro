---
// Peta lokasi toko (Google Maps embed), tampil abu-abu seperti referensi.
// Ukuran ditulis lewat <style> biasa (bukan Tailwind arbitrary class) supaya
// tinggi peta tidak bergantung pada scan JIT — iframe tanpa tinggi akan menciut.
import { MAP_EMBED_URL, STORE_NAME } from '../../data/contact';
---

<div class="contact-map">
  <iframe
    src={MAP_EMBED_URL}
    title={`Peta lokasi ${STORE_NAME}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .contact-map {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    background: #121212;
  }
  .contact-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) contrast(1.05);
  }
  @media (min-width: 1024px) {
    .contact-map {
      min-height: 640px;
    }
  }
</style>
