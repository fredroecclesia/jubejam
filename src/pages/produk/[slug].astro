---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductSpecs from '../../components/product/ProductSpecs.astro';
import {
  catalogHref,
  formatRupiah,
  yearLabel,
  getProductBySlug,
  getSimilarProducts,
  whatsappProductUrl,
} from '../../data/products';

// Dirender di server, sama seperti /produk. Nanti getProductBySlug() diganti
// query Drizzle (lihat data/products.ts).
const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : undefined;

// Slug tidak dikenal -> 404 (Astro menampilkan halaman 404 bawaan).
if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const similar = await getSimilarProducts(product);
const sold = product.status === 'sold';
const fullName = `${product.brandName} ${product.model}`;

const title = `${fullName} Ref. ${product.reference} — Jubejam`;
const description = sold
  ? `${fullName} Ref. ${product.reference} (${yearLabel(product.year)}) sudah terjual. Tanya admin Jubejam untuk jam serupa.`
  : `${fullName} Ref. ${product.reference} (${yearLabel(product.year)}), kondisi ${product.grade}, ${product.kelengkapan}. ${formatRupiah(product.price)}. 100% authentic or moneyback.`;

const trust = [
  { icon: 'shield', text: '100% authentic or moneyback' },
  { icon: 'truck', text: 'Dikirim aman dengan asuransi pengiriman' },
  { icon: 'store', text: 'Bisa dilihat langsung di offline store PIK Golf Island' },
];

const icon = 'h-4 w-4 shrink-0 text-gold';
---

<Layout title={title} description={description}>
  <Header />

  <main>
    <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
      <nav aria-label="Breadcrumb" class="py-5 text-[0.78rem] text-ink-dim">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <a href="/produk" class="transition-colors hover:text-ink">Produk</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <a href={catalogHref({ brand: product.brandSlug })} class="transition-colors hover:text-ink">{product.brandName}</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page" class="text-ink">{product.model}</span>
      </nav>

      <div class="grid gap-8 pb-12 sm:pb-16 lg:grid-cols-2 lg:gap-14">
        <ProductGallery product={product} />

        <div class="lg:pt-2">
          <p class="font-mono text-[0.72rem] tracking-[1.5px] text-gold-light">{product.brandName}</p>
          <h1 class="mt-2 font-serif text-[clamp(1.9rem,3.4vw,2.6rem)] font-normal leading-[1.12] text-ink">
            {product.model}
          </h1>
          <p class="mt-2 text-[0.9rem] text-ink-dim">Ref. {product.reference} &middot; {product.year === null ? 'Undated' : `Tahun ${product.year}`}</p>

          <p class="mt-6 text-[1.75rem] font-medium leading-tight text-ink">{sold ? 'Terjual' : formatRupiah(product.price)}</p>
          {
            !sold && (
              <p class="mt-1.5 text-[0.82rem] text-ink-dim">Harga masih bisa dinegosiasikan dengan admin.</p>
            )
          }

          <div class="mt-6 flex flex-col gap-2.5">
            <a
              href={whatsappProductUrl(product)}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 rounded-full bg-gold px-6 py-3.5 text-[0.9rem] font-semibold text-[#14110A] transition-colors duration-200 hover:bg-gold-light"
            >
              <svg viewBox="0 0 24 24" class="h-[1.15rem] w-[1.15rem]" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              {sold ? 'Tanya jam serupa via WhatsApp' : 'Tanya admin via WhatsApp'}
            </a>
            <a
              href="#spesifikasi"
              class="rounded-full border border-gold px-6 py-3 text-center text-[0.9rem] font-semibold text-gold-light transition-colors duration-200 hover:bg-gold hover:text-[#14110A]"
            >
              Lihat spesifikasi
            </a>
          </div>

          <ul class="mt-7 flex flex-col gap-2.5 text-[0.82rem] text-ink-dim">
            {
              trust.map((item) => (
                <li class="flex items-center gap-2.5">
                  <svg viewBox="0 0 24 24" class={icon} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {item.icon === 'shield' && (
                      <>
                        <path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z" />
                        <path d="m9 12 2 2 4-4" />
                      </>
                    )}
                    {item.icon === 'truck' && (
                      <>
                        <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" />
                        <circle cx="7" cy="17.5" r="1.75" />
                        <circle cx="17" cy="17.5" r="1.75" />
                      </>
                    )}
                    {item.icon === 'store' && (
                      <>
                        <path d="m4 9 1.5-5h13L20 9M4 9v11h16V9M4 9h16M9.5 20v-5h5v5" />
                      </>
                    )}
                  </svg>
                  {item.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <ProductSpecs product={product} />

    {
      similar.length > 0 && (
        <section aria-labelledby="similar-title" class="border-t border-hairline bg-bg-panel py-10 sm:py-14">
          <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
            <h2 id="similar-title" class="font-serif text-[1.5rem] font-normal leading-tight text-ink">Jam serupa</h2>
            <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
              {similar.map((p) => (
                <li>
                  <ProductCard product={p} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>