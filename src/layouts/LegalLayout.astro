---
// Layout untuk halaman legal (Terms, Privacy Policy, Return Policy, dst.).
// Halaman cukup mengisi teks lewat <slot />; header, footer, judul, tanggal
// pembaruan, dan gaya teks semua diurus di sini.
import Layout from './Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  heading: string; // judul H1 di halaman
  description: string; // meta description
  updatedAt: string; // tampilan, mis. "21 Oktober 2024"
  updatedIso: string; // atribut datetime, mis. "2024-10-21"
}

const { heading, description, updatedAt, updatedIso } = Astro.props;
---

<Layout title={`${heading} — Jubejam`} description={description}>
  <Header />

  <main class="bg-bg-panel-2">
    <article class="mx-auto max-w-[1180px] px-5 pb-20 pt-14 sm:px-8 sm:pb-28 sm:pt-20">
      <h1 class="font-sans text-[clamp(1.9rem,3vw,2.75rem)] font-normal uppercase leading-tight text-ink">
        {heading}
      </h1>

      <!-- Tanpa batas lebar teks, ritme paragraf seragam (mengikuti referensi situs lama) -->
      <div class="legal-prose mt-8 sm:mt-10">
        <p>Terakhir diperbarui: <time datetime={updatedIso}>{updatedAt}</time></p>
        <slot />
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Gaya teks untuk konten yang masuk lewat <slot /> (scoped style tidak menjangkau slot).
     Judul pasal (h2/h3) sengaja sama besar dengan teks biasa, hanya lebih tebal;
     jarak antar blok seragam 1.6em, seperti di halaman referensi. */
  .legal-prose {
    font-size: 1.05rem;
    line-height: 1.95;
    color: theme('colors.ink');
  }
  @media (min-width: 640px) {
    .legal-prose {
      font-size: 1.15rem;
    }
  }
  @media (min-width: 1024px) {
    .legal-prose {
      font-size: 1.2rem;
    }
  }
  .legal-prose > * + *,
  .legal-prose section > * + * {
    margin-top: 1.6em;
  }
  .legal-prose h2,
  .legal-prose h3 {
    font-size: inherit;
    font-weight: 600;
    line-height: inherit;
    color: theme('colors.ink');
  }
  .legal-prose strong {
    font-weight: 600;
    color: theme('colors.ink');
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal-prose li::marker {
    color: theme('colors.gold.DEFAULT');
  }
  .legal-prose li + li {
    margin-top: 0.4em;
  }
  /* Penanda bagian yang masih harus diisi (draf) — sengaja mencolok */
  .legal-prose mark {
    background: rgba(176, 141, 87, 0.4);
    color: inherit;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .legal-prose a {
    color: theme('colors.gold.light');
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .legal-prose a:hover {
    color: theme('colors.ink');
  }
</style>